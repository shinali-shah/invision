# Copy to .env; `npm start` reads it. Every line is optional.

# Meta Model API key from dev.meta.ai. Leave it empty and the whole demo runs offline:
# a scripted bilingual call stands in for the transcriber and every agent returns canned output.
MODEL_API_KEY=

# 1 (or true/yes) forces that offline mode even when a key is set. `npm run dev` sets it for you.
MOCK=

# Where the server listens. The phone and the Mac both use this port.
PORT=3000

# Whose phone this is. "I'm <name>" in the transcript picks your voice; the Mac's avatar shows your initials.
USER_NAME=Parth

# Sent to the transcriber as languageBias. Comma separated.
DEMO_LANGUAGES=English,Spanish

# The Muse models to call in live mode.
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_ASR_MODEL=muse-voice-transcribe-1.0

# Relative to the repo root; both folders are created on first use. Delete them to start clean.
DB_PATH=data/playback.db
RECORDINGS_DIR=data/recordings
